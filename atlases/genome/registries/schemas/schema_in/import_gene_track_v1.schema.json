{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "import_gene_track_v1.schema.json",
  "title": "import_gene_track_v1 — manifest contract for GFF3 / JSON gene-track imports",
  "description": "Validates POST /api/actions when type='import_gene_track'. Accepts a BRAKER / TOGA / RefSeq GFF3 (default), or a pre-normalised JSON ({features:[…]}). Emits gene_track_v1.",
  "type": "object",
  "required": ["target"],
  "additionalProperties": true,
  "properties": {
    "target": {
      "type": "object",
      "required": ["path"],
      "additionalProperties": true,
      "properties": {
        "path":    { "type": "string", "minLength": 1 },
        "subject": { "type": "string" }
      }
    },
    "params": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "haplotype":     { "type": "string" },
        "feature_types": { "type": "array", "items": { "type": "string" }, "default": ["gene"] },
        "max_rows":      { "type": "integer", "minimum": 1 }
      }
    }
  }
}
