{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "import_synteny_blocks_v1.schema.json",
  "title": "import_synteny_blocks_v1 — manifest contract for Cactus pairwise synteny JSON",
  "description": "Validates POST /api/actions when type='import_synteny_blocks'. Accepts a top-level {pairs:[{id,name,blocks:[…]}]} object. Emits synteny_blocks_v1.",
  "type": "object",
  "required": ["target"],
  "additionalProperties": true,
  "properties": {
    "target": {
      "type": "object",
      "required": ["path"],
      "additionalProperties": true,
      "properties": {
        "path":    { "type": "string", "minLength": 1 },
        "subject": { "type": "string" }
      }
    },
    "params": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "method": { "type": "string", "default": "cactus" }
      }
    }
  }
}
