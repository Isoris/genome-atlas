{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "chromosome_map_v1.schema.json",
  "title": "chromosome_map_v1 — per-haplotype chromosome inventory",
  "type": "object",
  "required": ["chroms"],
  "additionalProperties": true,
  "properties": {
    "haplotype": { "type": "string" },
    "chroms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "length_bp"],
        "additionalProperties": true,
        "properties": {
          "id":        { "type": "string" },
          "length_bp": { "type": "integer", "minimum": 0 },
          "ord":       { "type": "integer", "minimum": 0 },
          "scaffolds": {
            "type": "array",
            "items": { "type": "object", "additionalProperties": true }
          }
        }
      }
    },
    "source": { "type": "string" }
  }
}
