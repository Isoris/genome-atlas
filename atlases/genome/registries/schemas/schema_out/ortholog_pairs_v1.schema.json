{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ortholog_pairs_v1.schema.json",
  "title": "ortholog_pairs_v1 — OrthoFinder per-pair gene-level rows for page_orthologues View 3",
  "type": "object",
  "required": ["focal_id", "non_focal_id", "rows"],
  "additionalProperties": true,
  "properties": {
    "focal_id":     { "type": "string" },
    "non_focal_id": { "type": "string" },
    "n_rows":       { "type": "integer", "minimum": 0 },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["focal_gene"],
        "additionalProperties": true,
        "properties": {
          "focal_gene": { "type": "string" },
          "chrom":      { "type": "string" },
          "pos_bp":     { "type": "integer", "minimum": 0 },
          "orthologs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "kind"],
              "additionalProperties": true,
              "properties": {
                "id":     { "type": "string" },
                "chrom":  { "type": "string" },
                "pos_bp": { "type": "integer", "minimum": 0 },
                "kind":   { "type": "string", "enum": ["1:1", "1:n", "m:1", "m:n"] }
              }
            }
          }
        }
      }
    },
    "source": { "type": "string" }
  }
}
